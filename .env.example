# Server-only provider credentials. Never use a VITE_ prefix for secrets.
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
OPENROUTER_IMAGE_MODEL="google/gemini-2.5-flash-image-preview"

# Required PostgreSQL authentication/session/quota database.
DATABASE_URL="postgresql://user:password@localhost:5432/radmehr_ai"
# Use disable only for local development. Production defaults to verified TLS.
DATABASE_SSL_MODE="disable"
DATABASE_POOL_MAX="10"
DATABASE_IDLE_TIMEOUT_MS="30000"
DATABASE_CONNECT_TIMEOUT_MS="10000"

# Required canonical HTTPS origin in production; empty uses request origin in development.
APP_URL=""
PORT="3000"
# Set to 1 only behind exactly one trusted reverse proxy with direct app access blocked.
TRUST_PROXY="0"

# Separate PRIVATE persistent mounts. Never point either at dist/public.
UPLOADS_DIR=""
DATA_DIR=""

# Exact HTTPS hostnames approved for provider image downloads and remote references.
# No redirects, arbitrary hosts, embedded credentials, or custom ports are accepted.
REMOTE_IMAGE_HOSTS="images.unsplash.com"

# Optional separate test DB; otherwise tests run an isolated temporary PostgreSQL instance.
TEST_DATABASE_URL=""
TEST_DATABASE_SSL_MODE="disable"
